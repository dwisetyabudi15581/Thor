{
  "name": "mlbb-community-bot",
  "version": "3.9.11",
  "description": "Bot setup server Mobile Legends Community - Welcome/Goodbye, Verify, Ticket, Invoice, Key-driven VIP, Self-Role, Temp Voice, Announce & Embed Builder, Backup, Giveaway, Scheduled Announcements, Warn, Stats/Leaderboard, Poll, fully configurable from Discord",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "lint": "eslint index.js src/ handlers/ --ext .js",
    "lint:fix": "eslint index.js src/ handlers/ --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1"
  }
}
