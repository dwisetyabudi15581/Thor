# ===================================================
# MLBB Community Bot - Environment Variables
# ===================================================
# Copy file ini jadi .env, lalu isi value-nya.
#   cp .env.example .env
#
# ⚠️  JANGAN PERNAH commit .env ke git (sudah di .gitignore).
# ⚠️  JANGAN share token bot ke siapa pun — siapa pun yang
#     punya token bisa kontrol bot penuh, baca pesan, ban member.
# ⚠️  Kalau token bocor: langsung Reset Token di Discord Developer
#     Portal, jangan tunggu.

# Token bot Discord (WAJIB)
# Dapatkan dari: https://discord.com/developers/applications
#   → pilih aplikasi bot → Bot → "Reset Token"
# Token format: 70-90 char random string (bukan URL, bukan base64 pendek).
DISCORD_TOKEN=paste_token_bot_disini

# Guild ID (Server ID) untuk registrasi slash command INSTAN (1 detik).
# Kalau dikosongkan, bot fallback ke global commands (~1 jam untuk muncul).
#
# Cara dapatkan Guild ID:
#   1. Discord → User Settings → Advanced → enable "Developer Mode"
#   2. Klik kanan server Anda → "Copy ID"
#   3. Paste di sini (format: 17-19 digit angka)
GUILD_ID=

# Opsional: nama file log (default: bot.log). Dihapus juga tidak masalah.
# LOG_FILE=bot.log
