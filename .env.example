# Copy file ini jadi .env, lalu isi token-mu

# Token bot Discord (wajib)
# Dapatkan dari: https://discord.com/developers/applications → aplikasi bot → Bot → Reset Token
DISCORD_TOKEN=paste_token_bot_disini

# Guild ID (Server ID) untuk registrasi slash command instan (1 detik vs 1 jam)
# Cara dapatkan: Discord → Developer Mode (User Settings → Advanced) → klik kanan server → Copy ID
# Bot harus sudah di-invite ke guild ini.
# Jika dikosongkan, bot fallback ke global commands (perlu ~1 jam untuk muncul).
GUILD_ID=
