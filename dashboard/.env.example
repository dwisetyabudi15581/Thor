# Konfigurasi Thor Dashboard (bot gratis — ala Dyno)
# Salin file ini ke .env.local (pengembangan) atau tempel ke
# environment variables hosting (produksi). JANGAN commit .env*.

# Database SQLite (relatif terhadap folder dashboard/ — tempat perintah dijalankan)
DATABASE_URL=file:db/custom.db

# Kunci penanda tangan cookie sesi — WAJIB diganti dengan string acak
# panjang di produksi (mis. hasil `openssl rand -hex 32`)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Login demo (member & admin) — otomatis nonaktif begitu DISCORD_CLIENT_ID
# terisi; paksa aktif/none dengan true/false
DEMO_MODE=false

# ===== Discord OAuth2 (Developer Portal -> aplikasi -> OAuth2) =====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI yang didaftarkan di portal — dashboard menampilkan alamat
# yang tepat di halaman login (kotak "Pemilik bot"), salin dari sana:
#   https://<domain-dashboard>/api/auth/discord/callback
# Origin tetap (WAJIB di produksi agar redirect OAuth konsisten):
#   PUBLIC_ORIGIN=https://thor.contohmu.com
PUBLIC_ORIGIN=

# Discord ID (dipisah koma) yang otomatis jadi admin dashboard
ADMIN_DISCORD_IDS=

# ===== DASH API bot Thor (WAJIB — jembatan dashboard <-> bot) =====
# Harus SAMA PERSIS dengan .env bot Thor:
#   DASH_API_URL=http://127.0.0.1:8788   (bot dan web satu VPS)
#   DASH_API_TOKEN=<token-acak-yang-sama-di-kedua-sisi>
DASH_API_URL=http://127.0.0.1:8788
DASH_API_TOKEN=

# Link invite bot untuk tombol "Invite Thor" (opsional — ada default)
NEXT_PUBLIC_INVITE_URL=
